<?xml version="1.0"?>
<ruleset name="Motominator PHP style">
    <description>PSR-12 with explicit line width and multiline calls.</description>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="s"/>

    <file>app</file>
    <file>bootstrap/app.php</file>
    <file>bootstrap/providers.php</file>
    <file>scripts</file>
    <file>database</file>
    <file>routes</file>
    <file>tests</file>

    <rule ref="PSR12">
        <exclude name="Generic.Files.LineLength"/>
    </rule>
    <rule ref="vendor/slevomat/coding-standard/SlevomatCodingStandard/Sniffs/Files/LineLengthSniff.php">
        <properties>
            <property name="lineLengthLimit" value="120"/>
            <property name="ignoreComments" value="true"/>
            <property name="ignoreImports" value="true"/>
        </properties>
    </rule>
    <rule ref="vendor/slevomat/coding-standard/SlevomatCodingStandard/Sniffs/Functions/RequireMultiLineCallSniff.php">
        <properties>
            <property name="minLineLength" value="121"/>
        </properties>
    </rule>
</ruleset>
