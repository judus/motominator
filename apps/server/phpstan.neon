includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    level: max
    stubFiles:
        - stubs/FrameworkCallbacks.stub
    paths:
        - app
        - bootstrap/app.php
        - bootstrap/providers.php
        - scripts
        - database
        - routes
        - tests
    tmpDir: storage/framework/cache/phpstan
